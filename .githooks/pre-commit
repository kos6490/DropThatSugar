#!/bin/sh
# Unity 프로젝트 커밋 전 검사
# 활성화: git config core.hooksPath .githooks
# 우회(긴급 시): git commit --no-verify

MAX_BYTES=$((10 * 1024 * 1024))   # LFS가 아닌 파일 최대 크기: 10MB
fail=0

red()  { printf '\033[31m%s\033[0m\n' "$1"; }
warn() { printf '\033[33m%s\033[0m\n' "$1"; }

# 파일명에 공백이 있어도 처리되도록 줄 단위로 분리
IFS='
'

# --- 0. Git LFS 설치 확인 ---
if ! command -v git-lfs >/dev/null 2>&1; then
  red "[LFS] git-lfs가 설치되어 있지 않습니다. 설치 후 'git lfs install'을 실행하세요."
  fail=1
fi

added=$(git diff --cached --name-only --diff-filter=A)
deleted=$(git diff --cached --name-only --diff-filter=D)
changed=$(git diff --cached --name-only --diff-filter=ACMR)

in_index() { git ls-files --cached --error-unmatch -- "$1" >/dev/null 2>&1; }
# 파일 또는 폴더가 인덱스에 존재하는지
path_in_index() { [ -n "$(git ls-files --cached -- "$1" | head -n 1)" ]; }

# --- 1. 새로 추가된 에셋에 .meta가 함께 있는지 ---
for f in $added; do
  case "$f" in
    Assets/*.meta) ;;
    Assets/*)
      if ! in_index "$f.meta"; then
        red "[META] .meta 누락: $f  →  '$f.meta'도 함께 git add 하세요."
        fail=1
      fi
      # 상위 폴더들의 .meta도 확인
      dir=$(dirname "$f")
      while [ "$dir" != "Assets" ] && [ "$dir" != "." ]; do
        if ! in_index "$dir.meta"; then
          red "[META] 폴더 .meta 누락: $dir.meta"
          fail=1
        fi
        dir=$(dirname "$dir")
      done
      ;;
  esac
done

# --- 2. 원본 없는 .meta (고아 .meta) ---
for f in $added; do
  case "$f" in
    Assets/*.meta)
      asset="${f%.meta}"
      if ! path_in_index "$asset"; then
        red "[META] 원본이 없는 .meta: $f  →  원본 '$asset'을 함께 추가하거나 .meta를 빼세요."
        fail=1
      fi
      ;;
  esac
done

# --- 3. 원본은 삭제했는데 .meta가 남아 있는 경우 ---
for f in $deleted; do
  case "$f" in
    Assets/*.meta) ;;
    Assets/*)
      if in_index "$f.meta"; then
        red "[META] 원본 삭제 후 .meta가 남음: $f.meta  →  'git rm \"$f.meta\"'"
        fail=1
      fi
      ;;
  esac
done

# --- 4. 충돌 마커 ---
markers=$(git diff --cached -U0 --no-color | grep -nE '^\+(<<<<<<<|>>>>>>>)( |$)')
if [ -n "$markers" ]; then
  red "[MERGE] 충돌 마커가 남아 있습니다. 해결 후 다시 커밋하세요:"
  git diff --cached --name-only -G '^(<<<<<<<|>>>>>>>)( |$)' | sed 's/^/    /'
  fail=1
fi

# --- 5. LFS가 아닌 대용량 파일 ---
# LFS 추적 파일은 인덱스에 작은 포인터만 들어가므로, 인덱스의 blob 크기로 판단
for f in $changed; do
  size=$(git cat-file -s ":$f" 2>/dev/null) || continue
  if [ "$size" -gt "$MAX_BYTES" ]; then
    mb=$((size / 1024 / 1024))
    red "[SIZE] LFS가 아닌 대용량 파일(${mb}MB): $f  →  .gitattributes에 확장자를 LFS로 추가하세요."
    fail=1
  fi
done

# --- 6. Unity 버전 변경 ---
for f in $changed; do
  if [ "$f" = "ProjectSettings/ProjectVersion.txt" ] && [ "${ALLOW_UNITY_UPGRADE:-0}" != "1" ]; then
    red "[UNITY] ProjectVersion.txt가 변경되었습니다. 의도치 않은 Unity 버전 변경일 수 있습니다."
    warn "        되돌리기: git restore --staged --worktree ProjectSettings/ProjectVersion.txt"
    warn "        의도한 업그레이드라면: ALLOW_UNITY_UPGRADE=1 git commit ..."
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo
  red "커밋이 중단되었습니다. 위 항목을 수정한 뒤 다시 시도하세요."
  exit 1
fi

exit 0